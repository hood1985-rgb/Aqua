{
  "name": "aqua",
  "productName": "Aqua",
  "version": "1.3.0",
  "description": "Aqua — your personal assistant and cyber-buddy with an OpenAI brain. Runs on your PC as a desktop app.",
  "main": "main.js",
  "author": "Aqua",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win -p never",
    "dist:dir": "electron-builder --dir --win"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.aqua.cyberbuddy",
    "productName": "Aqua",
    "copyright": "Aqua — your cyber-buddy",
    "publish": [
      {
        "provider": "github",
        "owner": "hood1985-rgb",
        "repo": "Aqua"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "app.js",
      "brain.js",
      "pool.js",
      "tools.js",
      "biz.js",
      "phone-sync.js",
      "phone.html",
      "journal.js",
      "weather.js",
      "games.js",
      "style.css",
      "favicon.svg",
      "icons/**/*"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Aqua",
      "artifactName": "Aqua-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Aqua-Portable-${version}.${ext}"
    }
  }
}
